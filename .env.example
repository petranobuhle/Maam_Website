# Copy this file to .env for LOCAL development only. Never commit or share .env.
# DEBUG is OFF unless you turn it on here.
DEBUG=True
# Local value only. For production, generate a long random key (see docs/deployment.md).
SECRET_KEY=replace-with-a-random-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Production (Render) -----------------------------------------------------
# Set these in the Render dashboard (Environment), NOT in a file:
# DEBUG=False
# SECRET_KEY=<long random value, at least 50 characters>
# ALLOWED_HOSTS=<your-domain>          (Render's own *.onrender.com host is added automatically)
# CSRF_TRUSTED_ORIGINS=https://<your-domain>   (https://<render host> is added automatically)
# SECURE_HSTS_SECONDS=0                (raise only after HTTPS is confirmed working)
# DATABASE_URL=<Neon connection string, postgresql://...?sslmode=require>   (required when DEBUG=False)
# RESEND_API_KEY=<Resend API key>      (leave unset to switch staff email notifications off)
# RESEND_FROM_EMAIL=MAAM Website <onboarding@resend.dev>   (or an address on your verified domain)
# NOTIFICATION_EMAIL=mahwadupetra@gmail.com
# ADMIN_URL=<optional private admin path, e.g. maam-staff-7q4/>   (default: admin/)

# PostgreSQL example
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=maam
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
